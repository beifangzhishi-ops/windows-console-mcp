# Self-hosted Desktop Commander OAuth sidecar. Do not commit config/rdc.env.
RDC_SIDECAR_HOST=127.0.0.1
RDC_SIDECAR_PORT=18008
RDC_UPSTREAM_URL=http://127.0.0.1:18009
# Replace the hostname with the HTTPS origin that exposes this gateway (for example a Tailscale Funnel hostname).
RDC_ISSUER=https://your-machine.your-tailnet.ts.net/rdc
RDC_RESOURCE=https://your-machine.your-tailnet.ts.net/rdc/mcp
RDC_STATE_FILE=.state/rdc-oauth-state.json
RDC_UPSTREAM_SESSION_FILE=.state/rdc-upstream-session.json
RDC_APPROVAL_SECRET_FILE=.state/rdc-approval-secret.txt
RDC_LOG_DIR=logs
RDC_TOKEN_TTL_SECONDS=3600
RDC_WORKSPACE_MODE=0
RDC_WORKSPACE_STATE_FILE=.state/rdc-workspace-unused.json
